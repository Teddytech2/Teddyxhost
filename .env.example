# TEDDYXMDHOST — copy values into Heroku Settings > Config Vars.
# Do not commit real secrets to GitHub.

# Required: MongoDB Atlas connection string and database
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=teddyxhost

# Required in production: generate a long random secret (e.g. openssl rand -hex 32)
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Heroku supplies PORT automatically. HOST can remain 0.0.0.0.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# Public URLs are optional when frontend and API are served by the same Heroku app.
# Leave both unset to derive payment callback URLs from the incoming request.
# Set FRONTEND_URL only if the frontend is hosted on a different domain.
# FRONTEND_URL=https://your-frontend.example.com
# BACKEND_URL=https://your-backend.example.com

# Paystack — configure only if payments are enabled
PAYSTACK_SECRET_KEY=
PAYSTACK_SECRET_KEY_KE=

# Optional integrations/logging
LOG_LEVEL=info
JHP_PLATFORM=
JHP_PLATFORM_URL=
BASE_PATH=
RENDER_EXTERNAL_URL=
REPL_ID=
# Legacy alias accepted by the MongoDB adapter; prefer MONGODB_URI
MONGODB_URL=
# Not used as the Teddyxhost platform database; may be passed to customer bot apps only
DATABASE_URL=
